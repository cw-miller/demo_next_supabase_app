# Copy this file to .env.local and replace the placeholder values.
# Your Supabase project credentials are available in the Supabase dashboard.

# Public Supabase URL for client-side access
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co

# Public key used by browser code and SSR client creation
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
# Optionally use the publishable key if your project uses it
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Database connection used by Drizzle ORM and migrations
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@<YOUR_DB_HOST>:6543/postgres

# Direct connection string for Supabase-managed Postgres
DIRECT_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@<YOUR_DB_HOST>:5432/postgres

# Initial admin user email used by seeding scripts
INITIAL_ADMIN_EMAIL=admin@example.com
